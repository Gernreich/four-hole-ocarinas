{"command":"parameters.add","params":{"name":"window_w","expression":"14 mm","comment":"the window across, the duct's width"}},
{"command":"parameters.add","params":{"name":"window_l","expression":"7 mm","comment":"the window along the jet"}},
{"command":"parameters.add","params":{"name":"row_1","expression":"20 mm","comment":"the near holes, in from the mouth wall"}},
{"command":"parameters.add","params":{"name":"row_2","expression":"42 mm","comment":"the far holes, in from the mouth wall"}},
{"command":"parameters.add","params":{"name":"columns","expression":"34 mm","comment":"between the two columns of holes"}},
{"command":"parameters.add","params":{"name":"cellsX","expression":"floor(L/finger + 1e-9) - 1 + mod(floor(L/finger + 1e-9), 2)","unit":"","comment":"cells on an edge along X: odd, the top or the bottom owns both ends"}},
{"command":"parameters.add","params":{"name":"cellsY","expression":"floor(W/finger + 1e-9) - 1 + mod(floor(W/finger + 1e-9), 2)","unit":"","comment":"cells on an edge along Y: odd, the top or the bottom owns both ends"}},
{"command":"parameters.add","params":{"name":"cellsZ","expression":"floor(H/finger + 1e-9) - mod(floor(H/finger + 1e-9), 2)","unit":"","comment":"cells on an upright edge: even"}},
{"command":"parameters.add","params":{"name":"keep","expression":"floor(floor((W/2 - 12 mm)/(W/cellsY) + 1e-9)/2)","unit":"","comment":"the mouth side's cells on each side of the beak"}},
{"command":"parameters.add","params":{"name":"cavity_cm3","expression":"(L - 2*ply)*(W - 2*ply)*(H - 2*ply)/(1 cm)^3","unit":"","comment":"the air inside in cm3, for reading"}},
