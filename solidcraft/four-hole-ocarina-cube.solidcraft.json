{"commands":[
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"sheet thickness; every opening is through it"}},
{"command":"parameters.add","params":{"name":"finger","expression":"6 mm","comment":"the shortest cell along an edge"}},
{"command":"parameters.add","params":{"name":"temp_c","expression":"25","unit":"","comment":"the air's temperature, warm from the breath, degrees C"}},
{"command":"parameters.add","params":{"name":"c_mm_s","expression":"331300*sqrt(1 + temp_c/273.15)","unit":"","comment":"speed of sound, mm/s"}},
{"command":"parameters.add","params":{"name":"a4","expression":"440","unit":"","comment":"concert pitch, Hz"}},
{"command":"parameters.add","params":{"name":"window_w","expression":"14 mm","comment":"the window across, the duct's width"}},
{"command":"parameters.add","params":{"name":"window_l","expression":"7 mm","comment":"the window along the jet"}},
{"command":"parameters.add","params":{"name":"mouth","expression":"1","unit":"","comment":"scales the window's end correction (the generator's --mouth)"}},
{"command":"parameters.add","params":{"name":"rayleigh","expression":"8/(3*pi)","unit":"","comment":"end correction per radius, a flanged end"}},
{"command":"parameters.add","params":{"name":"kw","expression":"window_w*window_l/(ply + 2*rayleigh*sqrt(window_w*window_l/pi)*mouth)","comment":"the window's conductance"}},
{"command":"parameters.add","params":{"name":"ratio_R2","expression":"0.2690427539964356","unit":"","comment":"hole R2's conductance over the window's: the fingering search's result"}},
{"command":"parameters.add","params":{"name":"ratio_R1","expression":"0.5526430563627308","unit":"","comment":"hole R1's conductance over the window's: the fingering search's result"}},
{"command":"parameters.add","params":{"name":"ratio_L1","expression":"1.0744557902541454","unit":"","comment":"hole L1's conductance over the window's: the fingering search's result"}},
{"command":"parameters.add","params":{"name":"ratio_L2","expression":"1.016272770698283","unit":"","comment":"hole L2's conductance over the window's: the fingering search's result"}},
{"command":"parameters.add","params":{"name":"d_R2","expression":"((ratio_R2*kw)*rayleigh + sqrt(((ratio_R2*kw)*rayleigh)^2 + pi*(ratio_R2*kw)*ply))/(pi/2)","comment":"finger hole R2: pi d^2/4 = k (ply + rayleigh d)"}},
{"command":"parameters.add","params":{"name":"d_R1","expression":"((ratio_R1*kw)*rayleigh + sqrt(((ratio_R1*kw)*rayleigh)^2 + pi*(ratio_R1*kw)*ply))/(pi/2)","comment":"finger hole R1: pi d^2/4 = k (ply + rayleigh d)"}},
{"command":"parameters.add","params":{"name":"d_L1","expression":"((ratio_L1*kw)*rayleigh + sqrt(((ratio_L1*kw)*rayleigh)^2 + pi*(ratio_L1*kw)*ply))/(pi/2)","comment":"finger hole L1: pi d^2/4 = k (ply + rayleigh d)"}},
{"command":"parameters.add","params":{"name":"d_L2","expression":"((ratio_L2*kw)*rayleigh + sqrt(((ratio_L2*kw)*rayleigh)^2 + pi*(ratio_L2*kw)*ply))/(pi/2)","comment":"finger hole L2: pi d^2/4 = k (ply + rayleigh d)"}},
{"command":"parameters.add","params":{"name":"key_hz","expression":"c_mm_s/(2*pi)*sqrt((kw/(1 mm))/280000)","unit":"","comment":"the closed note; by default what a 280 cm3 cavity sounds. Type a frequency to resize"}},
{"command":"parameters.add","params":{"name":"cavity_mm3","expression":"(kw/(1 mm))*(c_mm_s/(2*pi*key_hz))^2","unit":"","comment":"the cavity key_hz needs, mm3 (the generator's --cavity-mm3)"}},
{"command":"parameters.add","params":{"name":"L","expression":"pow(cavity_mm3, 1/3)*(1 mm) + 2*ply","comment":"outside, mouth face to back (x): the cube that holds cavity_mm3"}},
{"command":"parameters.add","params":{"name":"W","expression":"L","comment":"outside, across (y)"}},
{"command":"parameters.add","params":{"name":"H","expression":"L","comment":"outside, bottom to top (z)"}},
{"command":"parameters.add","params":{"name":"pitch_hz","expression":"c_mm_s/(2*pi)*sqrt((kw/(1 mm))/((L - 2*ply)*(W - 2*ply)*(H - 2*ply)/(1 mm)^3))","unit":"","comment":"read only: what this box sounds closed"}},
{"command":"parameters.add","params":{"name":"semitones_a4","expression":"12*ln(pitch_hz/a4)/ln(2)","unit":"","comment":"read only: pitch_hz in semitones from A4 (-7 = D4)"}},
{"command":"parameters.add","params":{"name":"beak","expression":"18 mm","comment":"the beak, out from the mouth face"}},
{"command":"parameters.add","params":{"name":"beak_w","expression":"24 mm","comment":"the beak across"}},
{"command":"parameters.add","params":{"name":"tip","expression":"8 mm","comment":"the beak tip's rounding, along the beak"}},
{"command":"parameters.add","params":{"name":"duct_depth","expression":"0.5 mm","comment":"each half of the duct, engraved in the top and in the bird"}},
{"command":"parameters.add","params":{"name":"bevel","expression":"30 deg","comment":"the window's far edge, filed on the outside face"}},
{"command":"parameters.add","params":{"name":"row_1","expression":"20 mm","comment":"the near holes, in from the mouth wall"}},
{"command":"parameters.add","params":{"name":"row_2","expression":"42 mm","comment":"the far holes, in from the mouth wall"}},
{"command":"parameters.add","params":{"name":"columns","expression":"34 mm","comment":"between the two columns of holes"}},
{"command":"parameters.add","params":{"name":"cellsX","expression":"floor(L/finger + 1e-9) - 1 + mod(floor(L/finger + 1e-9), 2)","unit":"","comment":"read only: cells on an edge along X, odd: the top or the bottom owns both ends"}},
{"command":"parameters.add","params":{"name":"cellsY","expression":"floor(W/finger + 1e-9) - 1 + mod(floor(W/finger + 1e-9), 2)","unit":"","comment":"read only: cells on an edge along Y, odd: the top or the bottom owns both ends"}},
{"command":"parameters.add","params":{"name":"cellsZ","expression":"floor(H/finger + 1e-9) - mod(floor(H/finger + 1e-9), 2)","unit":"","comment":"read only: cells on an upright edge, even"}},
{"command":"parameters.add","params":{"name":"keep","expression":"floor(floor((W/2 - beak_w/2)/(W/cellsY) + 1e-9)/2)","unit":"","comment":"read only: the mouth side's cells each side of the beak; at 0 the top takes the whole mouth edge"}},
{"command":"parameters.add","params":{"name":"room_far","expression":"L - 2*ply - row_2 - max(d_R2, d_L2)/2","comment":"read only: past the far holes to the back wall; below 0 they run into it"}},
{"command":"parameters.add","params":{"name":"room_side","expression":"W/2 - ply - columns/2 - max(d_R2, d_R1, d_L1, d_L2)/2","comment":"read only: beside the holes to a side wall; below 0 they run into it"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2","-H/2"],"length":"ply","width":"W","height":"H","operation":"new","name":"side #1","body_name":"side #1"}},
{"command":"solid.box","params":{"corner":["-L/2","W/2 - ply","-H/2"],"length":"L","width":"ply","height":"H","operation":"new","name":"side #2","body_name":"side #2"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2","H/2 - ply"],"length":"L","width":"W","height":"ply","operation":"new","name":"top plate #3","body_name":"top plate #3"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2","-H/2"],"length":"L","width":"W","height":"ply","operation":"new","name":"bottom #4","body_name":"bottom #4"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2","-H/2"],"length":"L","width":"ply","height":"H","operation":"new","name":"side #5","body_name":"side #5"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2","-H/2"],"length":"ply","width":"W","height":"H","operation":"new","name":"mouth side #6","body_name":"mouth side #6"}},
{"command":"solid.box","params":{"corner":["-L/2 + (0)*(L/cellsX)","W/2 - ply","H/2 - ply"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["side #2"],"name":"cells 1"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 1"],"dir1":[1,0,0],"count1":"(cellsX + 1)/2","spacing1":"2*(L/cellsX)","name":"cells 1 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (1)*(L/cellsX)","W/2 - ply","H/2 - ply"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["top plate #3"],"name":"cells 2"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 2"],"dir1":[1,0,0],"count1":"(cellsX - 1)/2","spacing1":"2*(L/cellsX)","name":"cells 2 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (0)*(L/cellsX)","-W/2","H/2 - ply"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["side #5"],"name":"cells 3"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 3"],"dir1":[1,0,0],"count1":"(cellsX + 1)/2","spacing1":"2*(L/cellsX)","name":"cells 3 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (1)*(L/cellsX)","-W/2","H/2 - ply"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["top plate #3"],"name":"cells 4"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 4"],"dir1":[1,0,0],"count1":"(cellsX - 1)/2","spacing1":"2*(L/cellsX)","name":"cells 4 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2 + (0)*(W/cellsY)","H/2 - ply"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["side #1"],"name":"cells 5"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 5"],"dir1":[0,1,0],"count1":"(cellsY + 1)/2","spacing1":"2*(W/cellsY)","name":"cells 5 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2 + (1)*(W/cellsY)","H/2 - ply"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["top plate #3"],"name":"cells 6"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 6"],"dir1":[0,1,0],"count1":"(cellsY - 1)/2","spacing1":"2*(W/cellsY)","name":"cells 6 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (0)*(L/cellsX)","W/2 - ply","-H/2"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["side #2"],"name":"cells 7"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 7"],"dir1":[1,0,0],"count1":"(cellsX + 1)/2","spacing1":"2*(L/cellsX)","name":"cells 7 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (1)*(L/cellsX)","W/2 - ply","-H/2"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["bottom #4"],"name":"cells 8"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 8"],"dir1":[1,0,0],"count1":"(cellsX - 1)/2","spacing1":"2*(L/cellsX)","name":"cells 8 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (0)*(L/cellsX)","-W/2","-H/2"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["side #5"],"name":"cells 9"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 9"],"dir1":[1,0,0],"count1":"(cellsX + 1)/2","spacing1":"2*(L/cellsX)","name":"cells 9 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2 + (1)*(L/cellsX)","-W/2","-H/2"],"length":"L/cellsX","width":"ply","height":"ply","operation":"cut","targets":["bottom #4"],"name":"cells 10"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 10"],"dir1":[1,0,0],"count1":"(cellsX - 1)/2","spacing1":"2*(L/cellsX)","name":"cells 10 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2 + (0)*(W/cellsY)","-H/2"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["side #1"],"name":"cells 11"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 11"],"dir1":[0,1,0],"count1":"(cellsY + 1)/2","spacing1":"2*(W/cellsY)","name":"cells 11 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2 + (1)*(W/cellsY)","-H/2"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["bottom #4"],"name":"cells 12"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 12"],"dir1":[0,1,0],"count1":"(cellsY - 1)/2","spacing1":"2*(W/cellsY)","name":"cells 12 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + (0)*(W/cellsY)","-H/2"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["mouth side #6"],"name":"cells 13"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 13"],"dir1":[0,1,0],"count1":"(cellsY + 1)/2","spacing1":"2*(W/cellsY)","name":"cells 13 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + (1)*(W/cellsY)","-H/2"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["bottom #4"],"name":"cells 14"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 14"],"dir1":[0,1,0],"count1":"(cellsY - 1)/2","spacing1":"2*(W/cellsY)","name":"cells 14 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + (0)*(W/cellsY)","H/2 - ply"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["mouth side #6"],"name":"cells 15"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 15"],"dir1":[0,1,0],"count1":"keep + 1","spacing1":"2*(W/cellsY)","name":"cells 15 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + (cellsY - 1)*(W/cellsY)","H/2 - ply"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["mouth side #6"],"name":"cells 16"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 16"],"dir1":[0,-1,0],"count1":"keep + 1","spacing1":"2*(W/cellsY)","name":"cells 16 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + 2*keep*(W/cellsY)","H/2 - ply"],"length":"ply","width":"(cellsY - 4*keep)*(W/cellsY)","height":"ply","operation":"cut","targets":["mouth side #6"],"name":"mouth edge, under the beak"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + (1)*(W/cellsY)","H/2 - ply + (1 - min(keep, 1))*4*ply"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["top plate #3"],"name":"cells 17"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 17"],"dir1":[0,1,0],"count1":"max(keep, 1)","spacing1":"2*(W/cellsY)","name":"cells 17 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2 + (cellsY - 2)*(W/cellsY)","H/2 - ply + (1 - min(keep, 1))*4*ply"],"length":"ply","width":"W/cellsY","height":"ply","operation":"cut","targets":["top plate #3"],"name":"cells 18"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 18"],"dir1":[0,-1,0],"count1":"max(keep, 1)","spacing1":"2*(W/cellsY)","name":"cells 18 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","W/2 - ply","-H/2 + (0)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["side #2"],"name":"cells 19"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 19"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 19 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","W/2 - ply","-H/2 + (1)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["side #1"],"name":"cells 20"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 20"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 20 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","W/2 - ply","-H/2 + (0)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["mouth side #6"],"name":"cells 21"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 21"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 21 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","W/2 - ply","-H/2 + (1)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["side #2"],"name":"cells 22"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 22"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 22 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2","-H/2 + (0)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["side #5"],"name":"cells 23"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 23"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 23 pattern"}},
{"command":"solid.box","params":{"corner":["-L/2","-W/2","-H/2 + (1)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["mouth side #6"],"name":"cells 24"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 24"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 24 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2","-H/2 + (0)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["side #1"],"name":"cells 25"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 25"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 25 pattern"}},
{"command":"solid.box","params":{"corner":["L/2 - ply","-W/2","-H/2 + (1)*(H/cellsZ)"],"length":"ply","width":"ply","height":"H/cellsZ","operation":"cut","targets":["side #5"],"name":"cells 26"}},
{"command":"solid.pattern.rectangular","params":{"features":["cells 26"],"dir1":[0,0,1],"count1":"cellsZ/2","spacing1":"2*(H/cellsZ)","name":"cells 26 pattern"}},
{"command":"sketch.create","params":{"plane":"XY","offset":"H/2 - ply","name":"beak sketch"}},
{"command":"sketch.line","params":{"points":[["-L/2 + 0 mm","-beak_w/2*sin(90 deg)"],["-L/2 - beak + tip*(1 - cos(90 deg*-1))","beak_w/2*sin(90 deg*-1)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.9375))","beak_w/2*sin(90 deg*-0.9375)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.875))","beak_w/2*sin(90 deg*-0.875)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.8125))","beak_w/2*sin(90 deg*-0.8125)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.75))","beak_w/2*sin(90 deg*-0.75)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.6875))","beak_w/2*sin(90 deg*-0.6875)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.625))","beak_w/2*sin(90 deg*-0.625)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.5625))","beak_w/2*sin(90 deg*-0.5625)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.5))","beak_w/2*sin(90 deg*-0.5)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.4375))","beak_w/2*sin(90 deg*-0.4375)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.375))","beak_w/2*sin(90 deg*-0.375)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.3125))","beak_w/2*sin(90 deg*-0.3125)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.25))","beak_w/2*sin(90 deg*-0.25)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.1875))","beak_w/2*sin(90 deg*-0.1875)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.125))","beak_w/2*sin(90 deg*-0.125)"],["-L/2 - beak + tip*(1 - cos(90 deg*-0.0625))","beak_w/2*sin(90 deg*-0.0625)"],["-L/2 - beak + tip*(1 - cos(90 deg*0))","beak_w/2*sin(90 deg*0)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.0625))","beak_w/2*sin(90 deg*0.0625)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.125))","beak_w/2*sin(90 deg*0.125)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.1875))","beak_w/2*sin(90 deg*0.1875)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.25))","beak_w/2*sin(90 deg*0.25)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.3125))","beak_w/2*sin(90 deg*0.3125)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.375))","beak_w/2*sin(90 deg*0.375)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.4375))","beak_w/2*sin(90 deg*0.4375)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.5))","beak_w/2*sin(90 deg*0.5)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.5625))","beak_w/2*sin(90 deg*0.5625)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.625))","beak_w/2*sin(90 deg*0.625)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.6875))","beak_w/2*sin(90 deg*0.6875)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.75))","beak_w/2*sin(90 deg*0.75)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.8125))","beak_w/2*sin(90 deg*0.8125)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.875))","beak_w/2*sin(90 deg*0.875)"],["-L/2 - beak + tip*(1 - cos(90 deg*0.9375))","beak_w/2*sin(90 deg*0.9375)"],["-L/2 - beak + tip*(1 - cos(90 deg*1))","beak_w/2*sin(90 deg*1)"],["-L/2 + 0 mm","beak_w/2*sin(90 deg)"]],"closed":true}},
{"command":"sketch.finish","params":{}},
{"command":"solid.extrude","params":{"distance":"ply","operation":"join","targets":["top plate #3"],"name":"beak"}},
{"command":"solid.box","params":{"corner":["-L/2 + ply","-window_w/2","H/2 - ply"],"length":"window_l","width":"window_w","height":"ply","operation":"cut","targets":["top plate #3"],"name":"window"}},
{"command":"solid.hole","params":{"position":["-L/2 + ply + row_2","-columns/2","H/2"],"diameter":"d_R2","depth":"ply","name":"hole R2"}},
{"command":"solid.hole","params":{"position":["-L/2 + ply + row_1","-columns/2","H/2"],"diameter":"d_R1","depth":"ply","name":"hole R1"}},
{"command":"solid.hole","params":{"position":["-L/2 + ply + row_1","columns/2","H/2"],"diameter":"d_L1","depth":"ply","name":"hole L1"}},
