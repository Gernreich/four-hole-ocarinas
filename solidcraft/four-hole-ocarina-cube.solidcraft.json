{"commands":[
{"command":"parameters.add","params":{"name":"L","expression":"71.42132620377178 mm","comment":"outside, mouth face to back (x)"}},
{"command":"parameters.add","params":{"name":"W","expression":"L","comment":"outside, across (y)"}},
{"command":"parameters.add","params":{"name":"H","expression":"L","comment":"outside, bottom to top (z)"}},
{"command":"parameters.add","params":{"name":"ply","expression":"3 mm","comment":"sheet thickness"}},
{"command":"parameters.add","params":{"name":"finger","expression":"6 mm","comment":"the shortest cell along an edge"}},
{"command":"parameters.add","params":{"name":"d_R2","expression":"4.2028 mm","comment":"finger hole R2; set by the acoustic model for the default size"}},
{"command":"parameters.add","params":{"name":"d_R1","expression":"7.0428 mm","comment":"finger hole R1; set by the acoustic model for the default size"}},
{"command":"parameters.add","params":{"name":"d_L1","expression":"11.8391 mm","comment":"finger hole L1; set by the acoustic model for the default size"}},
