solidcraft/four-hole-ocarina-hexagonal-prism.sc :: target/release/four_hole_ocarinas --only=hexagonal-prism --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/four-hole-ocarina-hexagonal-prism.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
