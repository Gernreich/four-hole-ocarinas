# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# four_hole_ocarinas names its own sheets, so each command writes one build
# into $OUT's directory with --flat and the tool compares the file it asked
# for. The programs are Rust since 2026-11-07, built by repro-svg before these
# run; the crate borrows from square-flute, swept-curve and, through the square
# flute, bore-tmm, so those checkouts are expected beside this one.

# --- the cut files ---
cut-files/cube/four-hole-ocarina-cube-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=cube --flat --out=$(dirname $OUT)
cut-files/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=octagon --flat --out=$(dirname $OUT)
cut-files/square-antiprism/four-hole-ocarina-square-antiprism-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=square-antiprism --flat --out=$(dirname $OUT)
cut-files/octahedron/four-hole-ocarina-octahedron-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=octahedron --flat --out=$(dirname $OUT)
cut-files/dodecahedron/four-hole-ocarina-dodecahedron-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=dodecahedron --flat --out=$(dirname $OUT)
cut-files/truncated-octahedron/four-hole-ocarina-truncated-octahedron-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=truncated-octahedron --flat --out=$(dirname $OUT)
cut-files/hexagonal-prism/four-hole-ocarina-hexagonal-prism-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=hexagonal-prism --flat --out=$(dirname $OUT)
cut-files/icosahedron/four-hole-ocarina-icosahedron-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=icosahedron --flat --out=$(dirname $OUT)
cut-files/cuboctahedron/four-hole-ocarina-cuboctahedron-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=cuboctahedron --flat --out=$(dirname $OUT)
cut-files/rhombic-dodecahedron/four-hole-ocarina-rhombic-dodecahedron-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=rhombic-dodecahedron --flat --out=$(dirname $OUT)
cut-files/elongated-square-pyramid/four-hole-ocarina-elongated-square-pyramid-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=elongated-square-pyramid --flat --out=$(dirname $OUT)
cut-files/elongated-square-bipyramid/four-hole-ocarina-elongated-square-bipyramid-sheet1-cut-files.svg :: target/release/four_hole_ocarinas --only=elongated-square-bipyramid --flat --out=$(dirname $OUT)

# --- the previews, from the cut files ---
previews/cube/four-hole-ocarina-cube-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/cube/four-hole-ocarina-cube-sheet1-cut-files.svg $OUT
previews/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg $OUT
previews/square-antiprism/four-hole-ocarina-square-antiprism-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/square-antiprism/four-hole-ocarina-square-antiprism-sheet1-cut-files.svg $OUT
previews/octahedron/four-hole-ocarina-octahedron-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/octahedron/four-hole-ocarina-octahedron-sheet1-cut-files.svg $OUT
previews/dodecahedron/four-hole-ocarina-dodecahedron-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/dodecahedron/four-hole-ocarina-dodecahedron-sheet1-cut-files.svg $OUT
previews/truncated-octahedron/four-hole-ocarina-truncated-octahedron-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/truncated-octahedron/four-hole-ocarina-truncated-octahedron-sheet1-cut-files.svg $OUT
previews/hexagonal-prism/four-hole-ocarina-hexagonal-prism-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/hexagonal-prism/four-hole-ocarina-hexagonal-prism-sheet1-cut-files.svg $OUT
previews/icosahedron/four-hole-ocarina-icosahedron-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/icosahedron/four-hole-ocarina-icosahedron-sheet1-cut-files.svg $OUT
previews/cuboctahedron/four-hole-ocarina-cuboctahedron-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/cuboctahedron/four-hole-ocarina-cuboctahedron-sheet1-cut-files.svg $OUT
previews/rhombic-dodecahedron/four-hole-ocarina-rhombic-dodecahedron-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/rhombic-dodecahedron/four-hole-ocarina-rhombic-dodecahedron-sheet1-cut-files.svg $OUT
previews/elongated-square-pyramid/four-hole-ocarina-elongated-square-pyramid-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/elongated-square-pyramid/four-hole-ocarina-elongated-square-pyramid-sheet1-cut-files.svg $OUT
previews/elongated-square-bipyramid/four-hole-ocarina-elongated-square-bipyramid-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/elongated-square-bipyramid/four-hole-ocarina-elongated-square-bipyramid-sheet1-cut-files.svg $OUT

# --- the page ---
viewer.js :: target/release/page_assets --viewer-to=$OUT
turn.html :: target/release/page_assets --turn-to=$OUT
plans/four-hole-ocarina-top-plate.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
plans/four-hole-ocarina-fingering.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft scripts: the cube's parts as a parametric SolidCraft
# design (ply and the four holes live), written by the generator from the
# same parts as the cut files, and the cavity check run on top of it ---
solidcraft/four-hole-ocarina-cube.solidcraft.json :: target/release/four_hole_ocarinas --only=cube --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-cube.cavity.json :: target/release/four_hole_ocarinas --only=cube --no-write --solidcraft=$(dirname $OUT)

# --- the cube's STEP file, written by SolidCraft (solidcraft-cli, on PATH)
# from that script: true circles for the holes ---
step/four-hole-ocarinas-cube.step :: target/release/four_hole_ocarinas --only=cube --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/four-hole-ocarina-cube.solidcraft.json --out $OUT --quiet

# --- the other STEP files: the 3D view's parts as solids for a CAD program, one
# file per design, written from the page by lasermade-tools' step-export ---
step/four-hole-ocarinas-octagon.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-square-antiprism.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-octahedron.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-dodecahedron.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-truncated-octahedron.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-hexagonal-prism.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-icosahedron.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-cuboctahedron.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-rhombic-dodecahedron.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-elongated-square-pyramid.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
step/four-hole-ocarinas-elongated-square-bipyramid.step :: ../lasermade-tools/target/release/step-export viewer.js --name=four-hole-ocarinas --out=$(dirname $OUT)
