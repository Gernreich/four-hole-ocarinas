previews/cube/four-hole-ocarina-cube-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/cube/four-hole-ocarina-cube-sheet1-cut-files.svg $OUT
previews/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg $OUT
