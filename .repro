# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools/repro-svg.py; $OUT is where the file must be written.
#
# four_hole_ocarinas.py names its own sheets, so each command writes one build into
# $OUT's directory with --flat and the tool compares the file it asked for. It
# imports square_flute.py from the square-flute checkout beside this one, and
# that imports ribbon_bore.py from swept-curve, so all three are expected side
# by side.

# --- the cut files ---
cut-files/cube/four-hole-ocarina-cube-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=cube --flat --out=$(dirname $OUT)
cut-files/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=octagon --flat --out=$(dirname $OUT)
cut-files/square-antiprism/four-hole-ocarina-square-antiprism-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=square-antiprism --flat --out=$(dirname $OUT)
cut-files/octahedron/four-hole-ocarina-octahedron-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=octahedron --flat --out=$(dirname $OUT)
cut-files/dodecahedron/four-hole-ocarina-dodecahedron-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=dodecahedron --flat --out=$(dirname $OUT)
cut-files/truncated-octahedron/four-hole-ocarina-truncated-octahedron-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=truncated-octahedron --flat --out=$(dirname $OUT)
cut-files/hexagonal-prism/four-hole-ocarina-hexagonal-prism-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=hexagonal-prism --flat --out=$(dirname $OUT)
cut-files/icosahedron/four-hole-ocarina-icosahedron-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=icosahedron --flat --out=$(dirname $OUT)
cut-files/cuboctahedron/four-hole-ocarina-cuboctahedron-sheet1-cut-files.svg :: python3 four_hole_ocarinas.py --only=cuboctahedron --flat --out=$(dirname $OUT)

# --- the previews, from the cut files ---
previews/cube/four-hole-ocarina-cube-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/cube/four-hole-ocarina-cube-sheet1-cut-files.svg $OUT
previews/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/octagon/four-hole-ocarina-octagon-sheet1-cut-files.svg $OUT
previews/square-antiprism/four-hole-ocarina-square-antiprism-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/square-antiprism/four-hole-ocarina-square-antiprism-sheet1-cut-files.svg $OUT
previews/octahedron/four-hole-ocarina-octahedron-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/octahedron/four-hole-ocarina-octahedron-sheet1-cut-files.svg $OUT
previews/dodecahedron/four-hole-ocarina-dodecahedron-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/dodecahedron/four-hole-ocarina-dodecahedron-sheet1-cut-files.svg $OUT
previews/truncated-octahedron/four-hole-ocarina-truncated-octahedron-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/truncated-octahedron/four-hole-ocarina-truncated-octahedron-sheet1-cut-files.svg $OUT
previews/hexagonal-prism/four-hole-ocarina-hexagonal-prism-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/hexagonal-prism/four-hole-ocarina-hexagonal-prism-sheet1-cut-files.svg $OUT
previews/icosahedron/four-hole-ocarina-icosahedron-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/icosahedron/four-hole-ocarina-icosahedron-sheet1-cut-files.svg $OUT
previews/cuboctahedron/four-hole-ocarina-cuboctahedron-sheet1-cut-files.svg :: python3 ../lasermade-tools/make-preview.py cut-files/cuboctahedron/four-hole-ocarina-cuboctahedron-sheet1-cut-files.svg $OUT

# --- the page ---
viewer.js :: python3 page_assets.py --viewer-to=$OUT
turn.html :: python3 page_assets.py --turn-to=$OUT
plans/four-hole-ocarina-top-plate.svg :: python3 page_assets.py --plans-to=$(dirname $OUT)
plans/four-hole-ocarina-fingering.svg :: python3 page_assets.py --plans-to=$(dirname $OUT)
index.html :: python3 ../lasermade-tools/md2html.py README.md $OUT
