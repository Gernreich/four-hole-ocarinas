solidcraft/four-hole-ocarina-elongated-square-pyramid.sc :: target/release/four_hole_ocarinas --only=elongated-square-pyramid --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/four-hole-ocarina-elongated-square-pyramid.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
