# --- the page ---
viewer.js :: target/release/page_assets --viewer-to=$OUT
turn.html :: target/release/page_assets --turn-to=$OUT
plans/four-hole-ocarina-top-plate.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
plans/four-hole-ocarina-fingering.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft scripts: every build as a parametric SolidCraft design
# (its note, size, ply and holes live, the joints following), written by the
# generator from the same rules as the cut files, and the cube's cavity check ---
solidcraft/four-hole-ocarina-cube.solidcraft.json :: target/release/four_hole_ocarinas --only=cube --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-cube.cavity.json :: target/release/four_hole_ocarinas --only=cube --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-octagon.solidcraft.json :: target/release/four_hole_ocarinas --only=octagon --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-square-antiprism.solidcraft.json :: target/release/four_hole_ocarinas --only=square-antiprism --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-octahedron.solidcraft.json :: target/release/four_hole_ocarinas --only=octahedron --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-dodecahedron.solidcraft.json :: target/release/four_hole_ocarinas --only=dodecahedron --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-truncated-octahedron.solidcraft.json :: target/release/four_hole_ocarinas --only=truncated-octahedron --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-hexagonal-prism.solidcraft.json :: target/release/four_hole_ocarinas --only=hexagonal-prism --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-icosahedron.solidcraft.json :: target/release/four_hole_ocarinas --only=icosahedron --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-cuboctahedron.solidcraft.json :: target/release/four_hole_ocarinas --only=cuboctahedron --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-rhombic-dodecahedron.solidcraft.json :: target/release/four_hole_ocarinas --only=rhombic-dodecahedron --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-elongated-square-pyramid.solidcraft.json :: target/release/four_hole_ocarinas --only=elongated-square-pyramid --no-write --solidcraft=$(dirname $OUT)
solidcraft/four-hole-ocarina-elongated-square-bipyramid.solidcraft.json :: target/release/four_hole_ocarinas --only=elongated-square-bipyramid --no-write --solidcraft=$(dirname $OUT)

# --- the designs as SolidCraft opens them: each script built and saved, the
# build cache left out (lasermade-tools' sc-slim) so the file is the same every time ---
solidcraft/four-hole-ocarina-cube.sc :: target/release/four_hole_ocarinas --only=cube --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/four-hole-ocarina-cube.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
solidcraft/four-hole-ocarina-octagon.sc :: target/release/four_hole_ocarinas --only=octagon --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/four-hole-ocarina-octagon.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
